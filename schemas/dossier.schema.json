{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research dossier",
  "type": "object",
  "required": [
    "id",
    "question",
    "goal",
    "constraints",
    "unknowns",
    "next_searches",
    "evidence",
    "decision"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_searches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision": {
      "enum": [
        "open",
        "investigate",
        "watch",
        "reject",
        "propose"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim",
          "source",
          "observed_at",
          "basis"
        ],
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "enum": [
              "observed",
              "user-stated",
              "inferred",
              "external-claim",
              "tested"
            ]
          }
        }
      }
    }
  }
}
